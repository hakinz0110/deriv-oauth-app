# =============================================================================
# Deriv API Flask Application - Environment Configuration
# =============================================================================
# IMPORTANT: Never commit the actual .env file to source control
# This is a template with safe placeholder values only
# =============================================================================

# -----------------------------------------------------------------------------
# OAuth 2.0 Configuration
# -----------------------------------------------------------------------------
# Your Deriv app client ID (obtained from https://app.deriv.com/account/api-token)
CLIENT_ID=your_deriv_app_id_here

# OAuth redirect URI - must match the one configured in your Deriv app
# Examples:
#   - Local: http://localhost:5000/callback
#   - Production: https://your-app-name.onrender.com/callback
REDIRECT_URI=https://your-app-name.onrender.com/callback

# OAuth scopes - space-separated list of required permissions
# Available scopes: read, trade, trading_information, payments, admin, account_manage
# Default: trade account_manage (sufficient for Phase 2)
OAUTH_SCOPES=trade account_manage

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------
# Flask secret key for session encryption (MUST be changed in production)
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_a_secure_random_secret_key_here

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
# Flask environment: development, production
FLASK_ENV=production

# Flask debug mode: True for development, False for production
# WARNING: Never enable debug mode in production
FLASK_DEBUG=False

# -----------------------------------------------------------------------------
# Development Settings
# -----------------------------------------------------------------------------
# Mock OAuth mode - bypasses real OAuth flow for development/testing
# Set to True only in development when OAuth access is blocked
# WARNING: Never enable in production
MOCK_OAUTH=False

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# Deriv API endpoints are hardcoded in the application:
# - Authorization: https://auth.deriv.com/oauth2/auth
# - Token: https://auth.deriv.com/oauth2/token
# - Accounts: https://api.derivws.com/trading/v1/options/accounts
# - OTP: https://api.derivws.com/trading/v1/options/accounts/{accountId}/otp
# - Public WebSocket: wss://api.derivws.com/trading/v1/options/ws/public
# - Authenticated WebSocket: OTP URL from /otp endpoint

# -----------------------------------------------------------------------------
# Security Best Practices
# -----------------------------------------------------------------------------
# 1. Never log or print access tokens, refresh tokens, or OTP values
# 2. Never store tokens in browser localStorage or cookies
# 3. Always use HTTPS in production (redirect URI must be https://)
# 4. Rotate SECRET_KEY periodically
# 5. Use environment-specific .env files (.env.development, .env.production)
# 6. Review OAuth scopes - only request permissions you need
# 7. Keep dependencies updated (run: pip list --outdated)

# -----------------------------------------------------------------------------
# Phase 2 Status
# -----------------------------------------------------------------------------
# Implemented Features:
# - OAuth 2.0 with PKCE authentication
# - Token management with automatic refresh
# - Account retrieval and selection
# - Authenticated WebSocket URL generation
# - Public market data WebSocket access
#
# Not Yet Implemented:
# - Automated trading strategies
# - Contract proposals and execution
# - Portfolio management
# - Money management rules
