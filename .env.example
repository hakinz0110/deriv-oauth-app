# =============================================================================
# Deriv API Flask Application - Environment Configuration
# =============================================================================
# IMPORTANT: Never commit the actual .env file to source control
# This is a template with safe placeholder values only
# =============================================================================

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
# Options: development, staging, production
FLASK_ENV=production
FLASK_DEBUG=False
MOCK_OAUTH=False

# -----------------------------------------------------------------------------
# OAuth 2.0 Configuration
# -----------------------------------------------------------------------------
CLIENT_ID=your_deriv_app_id_here
REDIRECT_URI=https://your-app-name.onrender.com/callback
OAUTH_SCOPES=trade,read,admin

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_a_secure_random_secret_key_here

# Admin Panel Access Control
# Comma-separated list of email addresses allowed to access admin panel
# Example: ADMIN_EMAILS=admin@example.com,owner@example.com
ADMIN_EMAILS=your-email@example.com

# -----------------------------------------------------------------------------
# Supabase Configuration
# -----------------------------------------------------------------------------
# Get these from: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional: Service role key (for admin operations)
# WARNING: Never expose this key in frontend code
# SUPABASE_SERVICE_KEY=your-service-role-key-here

# -----------------------------------------------------------------------------
# Logging & Monitoring (Built-in)
# -----------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Enable access logs (gunicorn)
ACCESS_LOG=True

# -----------------------------------------------------------------------------
# Performance Settings
# -----------------------------------------------------------------------------
# Gunicorn workers (recommended: 2-4 for Railway/Render free tier)
WEB_CONCURRENCY=2
# Request timeout in seconds
TIMEOUT=120

# -----------------------------------------------------------------------------
# Database Configuration (Supabase handles backups automatically)
# -----------------------------------------------------------------------------
# Supabase provides:
# - Point-in-time recovery (PITR) for Pro plans
# - Daily automated backups for all plans
# - Manual backups available via dashboard
# No additional configuration needed

# -----------------------------------------------------------------------------
# Security Best Practices
# -----------------------------------------------------------------------------
# 1. Never log or print access tokens, refresh tokens, or OTP values
# 2. Never store sensitive tokens in browser localStorage
# 3. Always use HTTPS in production (redirect URI must be https://)
# 4. Rotate SECRET_KEY periodically (every 90 days minimum)
# 5. Use Row Level Security (RLS) policies in Supabase
# 6. Review OAuth scopes - only request permissions you need
# 7. Enable Supabase backups in project settings
# 8. Monitor application logs via Railway/Render dashboard
# 9. Set up alerts for critical errors (available in platform dashboards)

